#!/usr/bin/env bash
# Render the Outbound launch video or README stills from fictional fixture data.
# Isolated: temp Quickshell config, temp XDG dirs, offscreen rendering.
# Does not touch the desktop bar, shell.json or the installed plugin.
set -euo pipefail

repository="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:-$repository/demo/outbound-demo.mp4}"
for command in qs ffmpeg python3; do
  command -v "$command" >/dev/null || { printf 'Missing %s\n' "$command" >&2; exit 1; }
done

work="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/outbound-demo.XXXXXX")"
trap '[[ -n "${DEMO_KEEP:-}" ]] || rm -rf -- "$work"' EXIT INT TERM HUP
mkdir -p "$work/shell/plugin" "$work/frames" "$work/config" "$work/data"
cp "$repository"/*.qml "$repository"/*.js "$work/shell/plugin/"
cp -r "$repository/ui" "$repository/assets" "$work/shell/plugin/"
cp -r /usr/share/omarchy/shell/Commons /usr/share/omarchy/shell/Ui "$work/shell/"
# DEMO_SCENE picks the timeline: Launch (28.8 s beat-cut, default) or Screenshots
# (README stills, with DEMO_STILLS).
cp "$repository/demo/${DEMO_SCENE:-Launch}.qml" "$work/shell/shell.qml"

export OUTBOUND_BACKEND="$repository/demo/fixtures/outbound-engine"
export DEMO_FRAMES="$work/frames" DEMO_FPS="${DEMO_FPS:-30}"
export XDG_CONFIG_HOME="$work/config" XDG_DATA_HOME="$work/data"
# UTC keeps the capture machine's time zone out of the footer timestamp.
export TZ=UTC
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}" QT_SCALE_FACTOR="${DEMO_SCALE:-2}"
# The fixture engine must be the only collector the demo can start.
[[ -x "$OUTBOUND_BACKEND" ]] || { printf 'Fixture engine missing\n' >&2; exit 1; }

qs -p "$work/shell" 2>&1 | grep -E "DEMO_COMPLETE|ERROR|Error|error" || true
# DEMO_STILLS copies named stills (Screenshots scene) to a directory instead of encoding video.
if [[ -n "${DEMO_STILLS:-}" ]]; then
  mkdir -p "$DEMO_STILLS"
  compgen -G "$work/frames/*.png" >/dev/null || { printf 'No stills rendered\n' >&2; exit 1; }
  cp "$work/frames"/*.png "$DEMO_STILLS/"
  printf 'Stills → %s\n' "$DEMO_STILLS"; exit 0
fi
count=$(find "$work/frames" -name 'f*.png' | wc -l)
(( count > 0 )) || { printf 'No frames rendered\n' >&2; exit 1; }
ffmpeg -loglevel error -y -framerate "$DEMO_FPS" -i "$work/frames/f%04d.png" \
  -vf "scale=1440:1440:flags=lanczos,format=yuv420p" -c:v libx264 -preset slow -crf 18 \
  -movflags +faststart -an "$work/video.mp4"
# DEMO_AUDIO adds a soundtrack from its start, faded out over the last 1.7 s.
if [[ -n "${DEMO_AUDIO:-}" ]]; then
  length=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$work/video.mp4")
  ffmpeg -loglevel error -y -i "$work/video.mp4" -ss "${DEMO_AUDIO_START:-0}" -i "$DEMO_AUDIO" -map 0:v -map 1:a -c:v copy \
    -af "afade=t=in:d=0.05,afade=t=out:st=$(python3 -c "print(max(0, $length - 1.7))"):d=1.7" \
    -c:a aac -b:a 192k -shortest -movflags +faststart "$output"
else
  mv "$work/video.mp4" "$output"
fi
printf 'Rendered %s frames → %s\n' "$count" "$output"
